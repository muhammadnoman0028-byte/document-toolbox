{
  "id": "./index.html",
  "name": "Docx.Hub",
  "short_name": "Docx.Hub",
  "description": "Convert and compress DOCX, PDF, and image files in a premium neomorphic app.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e6ebf2",
  "theme_color": "#e6ebf2",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./public/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./public/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./public/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./public/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
